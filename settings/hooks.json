{
  "PreToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node",
          "args": ["{{CLAUDE_HOME}}/hooks/orchestration-guard.js", "ask"],
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node",
          "args": ["{{CLAUDE_HOME}}/hooks/orchestration-guard.js", "ask"],
          "timeout": 5
        }
      ]
    }
  ]
}
